{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "/home/vloshof/.config/fastfetch/niri.png",
        "width": 20,
        "height": 12,
        "padding": {
            "top": 2,
            "left": 2
        }
    },
    "display": {
    "separator": " ",
    "color": {
        "keys": "38;2;140;170;238"
    }
},
    "modules": [
        {
    "type": "title",
    "color": {
        "user": "38;2;197;208;245",
        "at": "38;2;81;87;109",
        "host": "38;2;140;170;238"
    }
},
        { "type": "separator", "string": "─", "color": "38;2;129;200;190" },
        { "type": "os", "key": "OS       │" },
        { "type": "kernel", "key": "Kernel   │" },
        { "type": "packages", "key": "Packages │" },
        { "type": "shell", "key": "Shell    │" },
        { "type": "separator", "string": "─", "color": "38;2;129;200;190" },
        { "type": "datetime", "key": "Date     │", "format": "{1}-{3}-{11}" },
        { "type": "de", "key": "DE       │" },
        { "type": "wm", "key": "WM       │" },
        { "type": "lm", "key": "LM       │" },
        { "type": "theme", "key": "Theme    │" },
        { "type": "icons", "key": "Icons    │" },
        { "type": "separator", "string": "─", "color": "38;2;129;200;190" },
        { "type": "cpu", "key": "CPU      │" },
        { "type": "gpu", "key": "GPU      │" },
        { "type": "memory", "key": "Memory   │" },
        { "type": "separator", "string": "─", "color": "38;2;129;200;190" }
    ]
}
