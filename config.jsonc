{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    
    "modules-left": [],
    "modules-center": [],
    "modules-right": [
        "wireplumber",
        "network",
        "battery",
        "clock#date",
        "clock#time",
        "custom-power"
    ],
    
    "wireplumber": {
        "format": " Vol: {volume}% ",
        "format-muted": " MUTE "
    },

    "network": {
        "format-wifi": " Wifi: {essid} ",
        "format-ethernet": " Filaire ",
        "format-disconnected": " Déconnecté "
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": " Bat: {capacity}% ",
        "format-charging": " Charge: {capacity}% "
    },

    // La date (via le module horloge natif)
    "clock#date": {
        "format": " {:%d/%m} "
    },

    // L'heure
    "clock#time": {
        "format": " {:%H:%M} "
    },

    // Le bouton éteindre réajusté
    "custom-power": {
        "format": " ⏻ ",
        "on-click": "echo -e 'Éteindre\nRedémarrer\nDéconnexion' | fuzzel --dmenu | xargs -I {} bash -c \"if [ '{}' = 'Éteindre' ]; then sudo poweroff; elif [ '{}' = 'Redémarrer' ]; then sudo reboot; elif [ '{}' = 'Déconnexion' ]; then niri msg action quit; fi\"",
        "tooltip": false
    }
}
